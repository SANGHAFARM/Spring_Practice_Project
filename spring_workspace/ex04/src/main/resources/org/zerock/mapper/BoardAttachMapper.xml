<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zerock.mapper.BoardAttachMapper">

	<!-- 첨부파일 1건의 메타데이터를 tbl_attach에 삽입 -->
	<insert id="insert">
		insert into tbl_attach (uuid, uploadpath, filename,
		filetype, bno)
		values (#{uuid}, #{uploadPath}, #{fileName},
		#{fileType}, #{bno} )
	</insert>

	<!-- 특정 게시물 번호(bno)에 첨부된 모든 파일 목록 조회 -->
	<select id="findByBno"
		resultType="org.zerock.domain.BoardAttachVO">
		select * from tbl_attach where bno = #{bno}
	</select>

	<!-- 어제 날짜(sysdate - 1)에 등록된 첨부파일 전체 조회 (스케줄러 정리용) -->
	<select id="getOldFiles"
		resultType="org.zerock.domain.BoardAttachVO">
		select * from tbl_attach where uploadpath = to_char(sysdate
		-1, 'yyyy\mm\dd')
	</select>

	<!-- UUID 고유 식별자 기준으로 특정 첨부파일 단건 삭제 -->
	<delete id="delete">
		delete from tbl_attach where uuid = #{uuid}
	</delete>

	<!-- 특정 게시물(bno)에 속한 모든 첨부파일 일괄 삭제 -->
	<delete id="deleteAll">
		delete tbl_attach where bno = #{bno}
	</delete>

</mapper>